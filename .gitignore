# .gitignore

# Ignore the file containing secrets and environment variables
.env
env.sh

# Ignore Python's cache and compiled files
__pycache__/
*.pyc

# Ignore the logs and csv files generated by the experiments
evaluation_results/
*.csv
logs/
*.log

# Ignore macOS generated files
.DS_Store?
ehthumbs.db
Icon?
Thumbs.db
*.DS_Store
